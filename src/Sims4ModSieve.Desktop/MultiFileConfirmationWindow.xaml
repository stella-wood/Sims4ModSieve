<Window x:Class="Sims4ModSieve.Desktop.MultiFileConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="324"
        Height="144"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center">
                <Path Data="M9,1 L17,16 L1,16 Z"
                      Stroke="#9A6A32" StrokeThickness="1.4" StrokeLineJoin="Round" />
                <Path Data="M9,6 L9,11"
                      Stroke="#9A6A32" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Width="2" Height="2" Fill="#9A6A32" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2.4" />
            </Grid>
            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Width="40"
                    Height="28"
                    Margin="0,0,8,0"
                    Content="否"
                    Cursor="Hand"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="0"
                    FontSize="12"
                    FontWeight="Normal"
                    Click="Cancel_Click" />
            <Button Width="40"
                    Height="28"
                    Content="是"
                    Cursor="Hand"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="0"
                    FontSize="12"
                    FontWeight="Normal"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
