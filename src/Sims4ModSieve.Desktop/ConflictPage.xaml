                                <Path Data="M1,2 L15,2 L10,8 L10,14 L6,12 L6,8 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.3" StrokeLineJoin="Round" />
                                <Ellipse Width="4" Height="4" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Visibility="{Binding HasActiveConflictFilter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </ToggleButton>
                        <Popup x:Name="ConflictFilterPopup" PlacementTarget="{Binding ElementName=ConflictFilterButton}" Placement="Custom" StaysOpen="True" AllowsTransparency="True" Opened="ConflictFilterPopup_Opened" Closed="ConflictFilterPopup_Closed"
                               IsOpen="{Binding IsChecked, ElementName=ConflictFilterButton, Mode=TwoWay}"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10,16,10" PreviewKeyDown="FilterPopupWindow_PreviewKeyDown">
                                <StackPanel Grid.IsSharedSizeScope="True">
                                    <Grid x:Name="ConflictStatusChoices">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="72" /><ColumnDefinition Width="Auto" SharedSizeGroup="ConflictFilterLastColumn" /></Grid.ColumnDefinitions>
                                        <CheckBox Content="全部" IsChecked="{Binding IncludeAllConflictStates}" Margin="0,4,0,4" HorizontalAlignment="Left" AutomationProperties.Name="全部状态" />
                                        <CheckBox Grid.Column="1" Content="需查看" IsChecked="{Binding IncludeConflictNeedsReview}" Margin="0,4,0,4" HorizontalAlignment="Left" />
                                        <CheckBox Grid.Column="2" Content="可整理" IsChecked="{Binding IncludeConflictCanOrganize}" Margin="0,4,0,4" HorizontalAlignment="Left" />
                                        <CheckBox Grid.Row="1" Content="未完成" IsChecked="{Binding IncludeConflictIncomplete}" Margin="0,4,0,4" HorizontalAlignment="Left" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,4" />
                                    <Grid x:Name="ConflictTypeChoices">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="72" /><ColumnDefinition Width="Auto" MinWidth="72" /><ColumnDefinition Width="Auto" SharedSizeGroup="ConflictFilterLastColumn" /></Grid.ColumnDefinitions>
                                        <CheckBox Content="全部" IsChecked="{Binding IncludeAllConflictTypes}" Margin="0,4,0,4" HorizontalAlignment="Left" AutomationProperties.Name="全部类型" />
                                        <CheckBox Grid.Column="1" Content="资源覆盖冲突" IsChecked="{Binding IncludeConflictOverrides}" Margin="0,4,0,4" HorizontalAlignment="Left" />
                                        <CheckBox Grid.Column="2" Content="脚本" IsChecked="{Binding IncludeConflictScripts}" Margin="0,4,0,4" HorizontalAlignment="Left" />
                                        <CheckBox Grid.Row="1" Content="合集包含" IsChecked="{Binding IncludeConflictCollections}" Margin="0,4,0,4" /><CheckBox Grid.Row="1" Grid.Column="1" Content="疑似同一 mod" IsChecked="{Binding IncludeConflictSuspected}" Margin="0,4,0,4" /><CheckBox Grid.Row="1" Grid.Column="2" Content="重复文件" IsChecked="{Binding IncludeConflictDuplicates}" Margin="0,4,0,4" />
                                    </Grid>
                                    <Border x:Name="ConflictIgnoredSeparator" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,4" />
                                    <CheckBox Content="显示已忽略" IsChecked="{Binding ShowIgnoredConflicts}" Margin="0,4,0,4" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        </Grid>
                    </Border>
                    <Grid x:Name="TechnicalViewport" Grid.Row="2" ClipToBounds="True">
                        <TextBlock Text="{Binding ConflictStatus}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowConflictPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ListBox x:Name="ConflictRowsList" Padding="20,6,8,12" ItemsSource="{Binding ConflictRows}" ItemTemplate="{StaticResource ConflictRowTemplate}" Style="{StaticResource ConflictListStyle}" VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseWheel="TechnicalOverlay_PreviewMouseWheel" PreviewMouseDown="TechnicalResults_PreviewMouseDown" PreviewKeyDown="TechnicalResults_PreviewKeyDown"
                                 Loaded="TechnicalResults_Loaded" Unloaded="TechnicalResults_Unloaded" LayoutUpdated="TechnicalResults_LayoutUpdated">
                            <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ResultVerticalScrollBarStyle}" /></ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title, Mode=OneWay}" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding Key, Mode=OneWay}" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <Canvas x:Name="TechnicalOverlay">
                            <Border x:Name="StickyTechnicalHeader" Background="{StaticResource SurfaceBrush}" Visibility="Collapsed" PreviewMouseWheel="TechnicalOverlay_PreviewMouseWheel">
                                <ContentControl x:Name="StickyTechnicalContent" ContentTemplate="{StaticResource ConflictTechnicalTableTemplate}" HorizontalContentAlignment="Stretch" />
                            </Border>
                            <Border x:Name="FloatingTechnicalScroll" Height="30" Opacity="0.25" Visibility="Collapsed" PreviewMouseWheel="TechnicalOverlay_PreviewMouseWheel">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00FFFFFF" Offset="0" /><GradientStop Color="#EEFFFFFF" Offset="0.6" /><GradientStop Color="#F8FFFFFF" Offset="1" /></LinearGradientBrush></Border.Background>
                                <ScrollBar x:Name="TechnicalTableScrollBar" Orientation="Horizontal" Style="{StaticResource ConflictTechnicalScrollBarStyle}" VerticalAlignment="Bottom" Margin="0,0,0,6" Minimum="0"
                                           MouseEnter="TechnicalTableScrollBar_MouseOverChanged" MouseLeave="TechnicalTableScrollBar_MouseOverChanged" IsMouseCaptureWithinChanged="TechnicalTableScrollBar_IsMouseCaptureWithinChanged"
                                           Maximum="{Binding ScrollableWidth, Mode=OneWay}" ViewportSize="{Binding ViewportWidth, Mode=OneWay}" Value="{Binding HorizontalOffset, Mode=TwoWay}" AutomationProperties.Name="横向滚动技术详情" />
                            </Border>
                            <Button x:Name="FloatingTechnicalCollapse" Content="收起" Style="{StaticResource ConflictTechnicalButtonStyle}" Background="{StaticResource SurfaceBrush}" Visibility="Collapsed" Click="FloatingTechnicalCollapse_Click" PreviewMouseWheel="TechnicalOverlay_PreviewMouseWheel" AutomationProperties.Name="收起技术详情">
                                <Button.Template><ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border Background="{StaticResource SurfaceBrush}" IsHitTestVisible="False">
                                            <Border.Effect><DropShadowEffect Color="#514A43" BlurRadius="7" ShadowDepth="1" Opacity="0.18" /></Border.Effect>
                                        </Border>
                                        <Border Background="{StaticResource SurfaceBrush}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter IsHitTestVisible="False" />
                                        </Border>
                                    </Grid>
                                </ControlTemplate></Button.Template>
                            </Button>
                        </Canvas>
                        <TextBlock Text="{Binding EmptyConflictText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyConflictRows, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <Border Grid.Row="3" Padding="20,11,36,11" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <Button x:Name="ToggleAllConflictGroupsButton" Width="24" Height="24" Cursor="Hand" Command="{Binding ToggleAllConflictGroupsCommand}" ToolTip="{Binding ConflictExpandCollapseToolTip}" Style="{StaticResource BareIconButtonStyle}">
                                    <Grid Width="16" Height="16" IsHitTestVisible="False">
                                        <Path Data="M 1,2 L 15,2 M 1,8 L 15,8 M 1,14 L 15,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="{Binding ShowCollapseAllConflictIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Path Data="M 1,5 L 15,5 M 1,8 L 15,8 M 1,11 L 15,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="{Binding ShowExpandAllConflictIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                                <TextBlock Text="{Binding ConflictFileActionStatusText}" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource DataTextStyle}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                <Button x:Name="UndoConflictDeleteButton" Content="撤回" Command="{Binding UndoLastDeleteCommand}" Style="{StaticResource HeaderBackButtonStyle}" Margin="8,0,0,0" Padding="4,2" Visibility="{Binding CanUndoConflictDelete, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </WrapPanel>
                            <TextBlock Text="没查出冲突不代表没有冲突" Visibility="{Binding ShowConflictWarning, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#9A6A32" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <local:ConflictRelationshipsDialog x:Name="RelationshipsDialog" />
    </Grid>
</UserControl>


