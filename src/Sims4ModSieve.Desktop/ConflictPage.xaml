<UserControl x:Class="Sims4ModSieve.Desktop.ConflictPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sims4ModSieve.Desktop">
    <UserControl.Resources>
        <Style x:Key="ConflictFilterButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="HitArea" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="EntranceActionStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitArea" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConflictOverviewActionStyle" TargetType="Button" BasedOn="{StaticResource EntranceActionStyle}">
            <Setter Property="Foreground" Value="#624D89" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ConflictTechnicalButtonStyle" TargetType="Button" BasedOn="{StaticResource EntranceActionStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="AutomationProperties.Name" Value="{Binding ExpandName, Mode=OneWay}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Key, Mode=OneWay}" />
        </Style>
        <Style x:Key="ConflictListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="ConflictNeedReviewBrush" Color="#D33C2E" />
        <SolidColorBrush x:Key="ConflictCanOrganizeBrush" Color="#D99316" />
        <SolidColorBrush x:Key="ConflictIncompleteBrush" Color="#948C84" />
        <SolidColorBrush x:Key="ConflictFilterHoverBrush" Color="#A892C5" />
        <Style x:Key="ConflictQuickFilterStyle" TargetType="Button">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Border x:Name="HoverUnderline" Height="2" Background="{StaticResource ConflictFilterHoverBrush}" VerticalAlignment="Bottom" Margin="8,0,8,0" Opacity="0" IsHitTestVisible="False" />
                    <Border x:Name="Underline" Height="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="8,0,8,0" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter TargetName="Underline" Property="Visibility" Value="Visible" /></Trigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter TargetName="Underline" Property="Visibility" Value="Visible" /></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource HoverTextBrush}" />
                        <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverUnderline" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverUnderline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ConflictAllFilterStyle" TargetType="Button" BasedOn="{StaticResource ConflictQuickFilterStyle}">
            <Setter Property="Padding" Value="0,3,8,3" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Border x:Name="HoverUnderline" Height="2" Background="{StaticResource ConflictFilterHoverBrush}" VerticalAlignment="Bottom" Margin="-3,0,5,0" Opacity="0" IsHitTestVisible="False" />
                    <Border x:Name="Underline" Height="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="-3,0,5,0" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter TargetName="Underline" Property="Visibility" Value="Visible" /></Trigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter TargetName="Underline" Property="Visibility" Value="Visible" /></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource HoverTextBrush}" />
                        <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverUnderline" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverUnderline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ConflictExpandButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,-5,0,-5" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding ExpandName, Mode=OneWay}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Key, Mode=OneWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitArea" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid IsHitTestVisible="False">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" BorderThickness="1" BorderBrush="Transparent">
                                    <Path x:Name="Arrow" Data="M6,3 L11,8 L6,13" Width="16" Height="16" HorizontalAlignment="Left" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" />
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="5,0,8,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConflictRowActionStyle" TargetType="Button">
            <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="Transparent">
                    <ContentPresenter x:Name="Icon" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Icon" Property="RenderTransform"><Setter.Value><TransformGroup><ScaleTransform ScaleX="0.92" ScaleY="0.92" /><TranslateTransform Y="1" /></TransformGroup></Setter.Value></Setter></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ConflictNameButtonStyle" TargetType="Button" BasedOn="{StaticResource EntranceActionStyle}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" /><Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="-10,-5,0,-5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="Transparent">
                    <ContentPresenter IsHitTestVisible="False" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ConflictEyeStyle" TargetType="Path">
            <Setter Property="Data" Value="M1,8 C4,2 12,2 15,8 C12,14 4,14 1,8 Z M10,8 A2,2 0 1 1 6,8 A2,2 0 1 1 10,8" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.2" /><Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers><DataTrigger Binding="{Binding IsIgnored}" Value="True"><Setter Property="Data" Value="M1,8 C4,2 12,2 15,8 C12,14 4,14 1,8 M2,2 L14,14 M6,6 L10,10" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="ConflictHeaderTemplate">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                <Button x:Name="ExpandButton" Style="{StaticResource ConflictExpandButtonStyle}" Command="{Binding DataContext.ToggleConflictExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="{StaticResource ConflictIncompleteBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="GroupLabel" Grid.Column="1" Text="{Binding GroupLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,3,9,0" />
                        <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="Title" Text="{Binding Title}" Foreground="{StaticResource InkBrush}" FontSize="15" FontWeight="SemiBold" ToolTip="{Binding Tooltip}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FileCountText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="12,4,0,0" />
                        </WrapPanel>
                    </Grid>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource ConflictRowActionStyle}" ToolTip="忽略／取消忽略本组" AutomationProperties.Name="忽略／取消忽略本组"
                        Command="{Binding DataContext.IgnoreConflictCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Path Style="{StaticResource ConflictEyeStyle}" /></Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="NeedsReview"><Setter TargetName="StateDot" Property="Fill" Value="{StaticResource ConflictNeedReviewBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="CanOrganize"><Setter TargetName="StateDot" Property="Fill" Value="{StaticResource ConflictCanOrganizeBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsIgnored}" Value="True"><Setter TargetName="Title" Property="FontWeight" Value="Normal" /><Setter TargetName="GroupLabel" Property="FontWeight" Value="Normal" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ConflictProblemHeaderTemplate">
            <Grid Margin="6,6,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Ellipse Width="10" Height="10" Fill="{StaticResource ConflictIncompleteBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="GroupLabel" Grid.Column="1" Text="{Binding GroupLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,9,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ProblemReason" Grid.Column="2" Text="{Binding Annotation}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsIgnored}" Value="True"><Setter TargetName="GroupLabel" Property="FontWeight" Value="Normal" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ConflictFileTemplate">
            <Border x:Name="FileSurface" Background="#F3F1ED" Margin="20,0,0,0" Padding="38,10,10,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Margin="0,0,10,0">
                        <Grid Width="{Binding ActualWidth, ElementName=Title}" HorizontalAlignment="Left">
                            <Button x:Name="FileDetailsButton" Style="{StaticResource ConflictNameButtonStyle}" ToolTip="{Binding File.Path}" AutomationProperties.Name="{Binding Title}"
                                    Command="{Binding DataContext.OpenConflictRelationshipsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </Grid>
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock x:Name="Title" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}" Text="{Binding Title}" FontFamily="等线" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" IsHitTestVisible="False" />
                                <Border x:Name="FileTag" Background="#EEE9F3" CornerRadius="2" Padding="5,1" Margin="8,1,0,0" IsHitTestVisible="False" Visibility="{Binding HasTag, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding Tag}" Foreground="#8B769F" FontSize="10" /></Border>
                                <Border x:Name="AnnotationSurface" Background="Transparent" Margin="10,3,0,0" ToolTip="{Binding AnnotationTooltip}" Visibility="{Binding HasAnnotation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock x:Name="AnnotationText" Text="{Binding Annotation}" Foreground="{StaticResource MutedBrush}" FontSize="11" IsHitTestVisible="False" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding File.Path}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" />
                            <WrapPanel>
                                <TextBlock Text="{Binding File.Metadata}" FontSize="11" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" />
                                <Button Margin="18,0,0,0" Style="{StaticResource EntranceActionStyle}" Padding="0" FontSize="11" Foreground="#A892C5" Content="{Binding CopiesLabel}" Visibility="{Binding HasCopies, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Command="{Binding DataContext.JumpToConflictGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding DuplicateLink}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource ConflictRowActionStyle}" ToolTip="打开所在文件夹" AutomationProperties.Name="打开所在文件夹" Command="{Binding DataContext.OpenConflictFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Path Width="16" Height="16" IsHitTestVisible="False" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M1,4 L6,4 L8,6 L15,6 L15,14 L1,14 Z M1,6 L1,2 L6,2 L8,4 L14,4 L14,6" />
                        </Button>
                        <Button x:Name="FileIgnoreButton" Style="{StaticResource ConflictRowActionStyle}" ToolTip="忽略文件（仅本组）" AutomationProperties.Name="忽略文件（仅本组）" Command="{Binding DataContext.IgnoreConflictCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Path Style="{StaticResource ConflictEyeStyle}" /></Button>
                        <Button Style="{StaticResource ConflictRowActionStyle}" IsEnabled="{Binding File.HasStamp}" ToolTip="移动到回收站" AutomationProperties.Name="移动到回收站" Command="{Binding DataContext.DeleteConflictFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Path Width="16" Height="16" IsHitTestVisible="False" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M2,4 L14,4 M6,4 L6,2 L10,2 L10,4 M4,4 L5,14 L11,14 L12,4 M7,6 L7,12 M9,6 L9,12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsProblemFileContent}" Value="True"><Setter TargetName="FileSurface" Property="Margin" Value="0" /><Setter TargetName="FileSurface" Property="Padding" Value="38,4,10,10" /></DataTrigger>
                <DataTrigger Binding="{Binding IsBundle}" Value="True"><Setter TargetName="FileSurface" Property="Background" Value="#E5E0D9" /><Setter TargetName="FileSurface" Property="Margin" Value="20,0,0,12" /></DataTrigger>
                <DataTrigger Binding="{Binding IsIgnored}" Value="True"><Setter TargetName="Title" Property="FontWeight" Value="Normal" /></DataTrigger>
                <DataTrigger Binding="{Binding AnnotationTooltip}" Value="{x:Null}"><Setter TargetName="AnnotationSurface" Property="ToolTipService.IsEnabled" Value="False" /></DataTrigger>
                <DataTrigger Binding="{Binding Annotation}" Value="内容完全相同"><Setter TargetName="AnnotationText" Property="Foreground" Value="#A892C5" /></DataTrigger>
                <DataTrigger Binding="{Binding Annotation}" Value="存在不同"><Setter TargetName="AnnotationText" Property="Foreground" Value="#A892C5" /></DataTrigger>
                <DataTrigger Binding="{Binding Annotation}" Value="已被包含"><Setter TargetName="AnnotationText" Property="Foreground" Value="#A892C5" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ConflictTextTemplate">
            <Grid x:Name="TextLayout" Margin="26,6,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Title" Grid.ColumnSpan="2" Text="{Binding Title}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" ToolTip="{Binding Tooltip}" />
                <Button x:Name="DuplicateNavigation" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource EntranceActionStyle}" Padding="0" Foreground="#A892C5" FontSize="11"
                        Command="{Binding DataContext.OpenConflictDuplicatesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding DuplicateLink}">
                    <TextBlock Text="去重复检测一键处理 →" TextDecorations="Underline" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsProblemFileContent}" Value="True"><Setter TargetName="TextLayout" Property="Margin" Value="6,6,0,7" /></DataTrigger>
                <DataTrigger Binding="{Binding IsDuplicateExplanation}" Value="True"><Setter TargetName="Title" Property="Grid.ColumnSpan" Value="1" /><Setter TargetName="DuplicateNavigation" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Tooltip}" Value=""><Setter TargetName="Title" Property="ToolTip" Value="{x:Null}" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Technical"><Setter TargetName="Title" Property="FontSize" Value="10" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ConflictTechnicalToggleTemplate">
            <Button x:Name="TechnicalToggleButton" Margin="26,5,0,0" HorizontalAlignment="Right" Content="{Binding Title}" Style="{StaticResource ConflictTechnicalButtonStyle}"
                    Command="{Binding DataContext.ToggleConflictExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
        </DataTemplate>
        <DataTemplate x:Key="ConflictTechnicalRelatedLinkTemplate">
            <Button Content="{Binding TechnicalLabel}" Style="{StaticResource ConflictTechnicalButtonStyle}" Foreground="#8B72A0" Padding="0" Margin="0,0,12,6" FontSize="10"
                    Command="{Binding DataContext.JumpToConflictGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
        </DataTemplate>
        <DataTemplate x:Key="ConflictTechnicalRelatedGroupsTemplate">
            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource ConflictTechnicalRelatedLinkTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="ConflictTechnicalCellTemplate">
            <Border x:Name="Cell" Width="{Binding Table.CellWidth, Mode=OneWay}">
                <StackPanel x:Name="CellContent" Margin="0,0,12,0" VerticalAlignment="Top">
                    <TextBlock x:Name="FileName" Text="{Binding FileName}" TextWrapping="Wrap" ToolTip="{Binding Evidence}" />
                    <TextBlock x:Name="Version" Text="{Binding Version}" TextWrapping="Wrap" ToolTip="{Binding Evidence}" />
                    <ContentControl x:Name="RelatedContent" HorizontalContentAlignment="Stretch" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding FileName}" Value=""><Setter TargetName="FileName" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding Version}" Value=""><Setter TargetName="Version" Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding IsType}" Value="True"><Setter TargetName="Cell" Property="Width" Value="80" /></DataTrigger>
                <DataTrigger Binding="{Binding IsRelated}" Value="True"><Setter TargetName="Cell" Property="Width" Value="224" /><Setter TargetName="RelatedContent" Property="Content" Value="{Binding RelatedGroups}" /><Setter TargetName="RelatedContent" Property="ContentTemplate" Value="{StaticResource ConflictTechnicalRelatedGroupsTemplate}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsHeader}" Value="True"><Setter TargetName="CellContent" Property="VerticalAlignment" Value="Center" /></DataTrigger>
                <DataTrigger Binding="{Binding IsIdenticalVersion}" Value="True"><Setter TargetName="CellContent" Property="TextBlock.Foreground" Value="#A39E98" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ConflictTechnicalTableTemplate">
            <Grid x:Name="TableRow" Margin="26,8,0,8" MinHeight="26" TextBlock.FontSize="10" TextBlock.Foreground="{StaticResource MutedBrush}" TextBlock.FontWeight="Normal">
                <Grid.ColumnDefinitions><ColumnDefinition Width="116" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Identifier" Text="{Binding TechnicalEntry.TableIdentifier}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,8,0" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding TechnicalEntry.Cells}" ItemTemplate="{StaticResource ConflictTechnicalCellTemplate}" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="Normal"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="0">
                    <ItemsControl.Template><ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="TechnicalColumnsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False" Background="Transparent"
                                      Loaded="TechnicalColumns_Loaded" Unloaded="TechnicalColumns_Unloaded" DataContextChanged="TechnicalColumns_DataContextChanged" ScrollChanged="TechnicalColumns_ScrollChanged" PreviewMouseWheel="TechnicalColumns_PreviewMouseWheel"><ItemsPresenter /></ScrollViewer>
                    </ControlTemplate></ItemsControl.Template>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
            <DataTemplate.Triggers><DataTrigger Binding="{Binding Kind}" Value="TechnicalHeader">
