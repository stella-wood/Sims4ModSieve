                    </RepeatButton>
                    <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal" IsDirectionReversed="False" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb x:Name="ScrollThumb" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#CCCCCC" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                    <RepeatButton x:Name="RightArrow" Grid.Column="2" Focusable="False" AutomationProperties.Name="向右滚动文件列" Command="{x:Static ScrollBar.LineRightCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"><Path Data="M1,0 L4,3 L1,6" Stroke="#9C9C9C" StrokeThickness="1.2" Width="5" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" /></Border></ControlTemplate></RepeatButton.Template>
                    </RepeatButton>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="ConflictTechnicalScrollTemplate"><Border Height="1" Margin="26,8,0,8" /></DataTemplate>
        <DataTemplate x:Key="ConflictCopyTemplate">
            <Button Content="复制详情" Style="{StaticResource ConflictTechnicalButtonStyle}" Margin="26,4,0,6" HorizontalAlignment="Right"
                    Command="{Binding DataContext.CopyConflictDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
        </DataTemplate>
        <DataTemplate x:Key="ConflictReferenceTemplate">
            <Button Content="{Binding Title}" Style="{StaticResource ConflictTechnicalButtonStyle}" Margin="26,3,0,3" HorizontalAlignment="Left"
                    Command="{Binding DataContext.JumpToConflictGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding RelatedLink}" />
        </DataTemplate>
        <DataTemplate x:Key="ConflictRowTemplate">
            <Border x:Name="Row" Background="{StaticResource SurfaceBrush}">
                <Grid x:Name="RowContent">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
                        <ContentControl.Style><Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource ConflictTextTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardStart}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ConflictHeaderTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="File"><Setter Property="ContentTemplate" Value="{StaticResource ConflictFileTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Problem"><Setter Property="ContentTemplate" Value="{StaticResource ConflictProblemHeaderTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Technical"><Setter Property="ContentTemplate" Value="{StaticResource ConflictTechnicalTableTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="TechnicalHeader"><Setter Property="ContentTemplate" Value="{StaticResource ConflictTechnicalTableTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="TechnicalListHeader"><Setter Property="ContentTemplate" Value="{StaticResource ConflictTechnicalListHeaderTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="TechnicalListFile"><Setter Property="ContentTemplate" Value="{StaticResource ConflictTechnicalListFileTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="TechnicalScroll"><Setter Property="ContentTemplate" Value="{StaticResource ConflictTechnicalScrollTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsTechnicalToggle}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ConflictTechnicalToggleTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="CopyDetails"><Setter Property="ContentTemplate" Value="{StaticResource ConflictCopyTemplate}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="GroupReference"><Setter Property="ContentTemplate" Value="{StaticResource ConflictReferenceTemplate}" /></DataTrigger>
                                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Kind}" Value="Technical" /><Condition Binding="{Binding TechnicalEntry}" Value="{x:Null}" /><Condition Binding="{Binding IsExpandable}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="ContentTemplate" Value="{StaticResource ConflictTextTemplate}" /></MultiDataTrigger>
                            </Style.Triggers>
                        </Style></ContentControl.Style>
                    </ContentControl>
                    <Line Grid.Row="1" Height="1" Margin="20,0,0,10" X1="0" X2="1" Stretch="Fill" Stroke="{StaticResource BorderBrush}" StrokeDashArray="2,4" StrokeThickness="1" SnapsToDevicePixels="True" Visibility="{Binding IsCardEnd, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsProblemFileContent}" Value="True"><Setter TargetName="RowContent" Property="Background" Value="#F3F1ED" /><Setter TargetName="RowContent" Property="Margin" Value="20,0,0,0" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Problem"><Setter TargetName="RowContent" Property="Background" Value="{StaticResource SurfaceBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding IsIgnored}" Value="True"><Setter TargetName="Row" Property="Opacity" Value="0.75" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>
    <Grid Background="{StaticResource WindowBrush}">
        <Grid Margin="70,38,100,30" Visibility="{Binding IsConflictOverview, Converter={StaticResource BooleanToVisibilityConverter}}">
