            <ScrollViewer x:Name="ConflictOverviewViewport" Grid.Row="1" Margin="0,26,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" ScrollChanged="ConflictOverviewViewport_ScrollChanged">
