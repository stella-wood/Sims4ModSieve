<UserControl x:Class="Sims4ModSieve.Desktop.ConflictPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ConflictChoiceStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="{StaticResource AccentSoftBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="EntranceActionStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitArea" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HitArea" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConflictListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="ConflictNeedReviewBrush" Color="#A65F52" />
        <SolidColorBrush x:Key="ConflictCanOrganizeBrush" Color="#B18436" />
        <Style x:Key="ConflictExpandButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="ToolTip" Value="展开" />
            <Setter Property="AutomationProperties.Name" Value="{Binding ExpandName, Mode=OneWay}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Key, Mode=OneWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitArea" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Path x:Name="Arrow" Data="M6,3 L11,8 L6,13" Width="16" Height="16" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HitArea" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="ToolTip" Value="收起" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="ConflictRowTemplate">
            <Border x:Name="Row" Padding="0,5,0,5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button VerticalAlignment="Top" Style="{StaticResource ConflictExpandButtonStyle}"
                            Visibility="{Binding IsExpandable, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding DataContext.ToggleConflictExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <StackPanel Grid.Column="1" Margin="5,3,8,3">
                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}" />
                        <TextBlock Text="{Binding SecondTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SecondTooltip}" Visibility="{Binding HasSecondTitle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,3,0" Visibility="{Binding HasState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Ellipse x:Name="StateDot" Width="6" Height="6" Margin="0,0,5,0" Fill="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{StaticResource InkBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Depth}" Value="1"><Setter TargetName="Row" Property="Margin" Value="16,0,0,0" /></DataTrigger>
                <DataTrigger Binding="{Binding Depth}" Value="2"><Setter TargetName="Row" Property="Margin" Value="32,0,0,0" /></DataTrigger>
                <DataTrigger Binding="{Binding Depth}" Value="3"><Setter TargetName="Row" Property="Margin" Value="48,0,0,0" /></DataTrigger>
                <DataTrigger Binding="{Binding Depth}" Value="4"><Setter TargetName="Row" Property="Margin" Value="64,0,0,0" /></DataTrigger>
                <DataTrigger Binding="{Binding Depth}" Value="5"><Setter TargetName="Row" Property="Margin" Value="80,0,0,0" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Technical"><Setter TargetName="Title" Property="FontWeight" Value="Normal" /><Setter TargetName="Title" Property="FontSize" Value="10" /><Setter TargetName="Title" Property="Foreground" Value="{StaticResource MutedBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Explanation"><Setter TargetName="Title" Property="FontWeight" Value="Normal" /><Setter TargetName="Title" Property="TextWrapping" Value="Wrap" /></DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="NeedsReview"><Setter TargetName="StateDot" Property="Fill" Value="{StaticResource ConflictNeedReviewBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="CanOrganize"><Setter TargetName="StateDot" Property="Fill" Value="{StaticResource ConflictCanOrganizeBrush}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{StaticResource WindowBrush}">
        <Grid Margin="70,38,100,30" Visibility="{Binding IsConflictOverview, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="Mod 冲突检测" FontSize="35" Style="{StaticResource DisplayTextStyle}" />
            <TextBlock Grid.Row="1" Margin="0,10,0,26" Text="选择一种排查方式" FontSize="16" Foreground="{StaticResource MutedBrush}" />
            <UniformGrid Grid.Row="2" Columns="2" Rows="2">
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,10,10">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Top" Width="46" Height="46" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><Path Data="M2,12 L7,3 L13,12 L18,3 L23,12" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" Width="27" Height="27" Stretch="Uniform" IsHitTestVisible="False" /></Border>
                        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,5" Text="基础排查" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Text="比较资源覆盖与脚本模块，查看内容差异" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Button DockPanel.Dock="Bottom" Margin="-9,2,0,0" Content="进入排查→" Command="{Binding OpenConflictSectionCommand}" CommandParameter="basic" Style="{StaticResource EntranceActionStyle}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="10,0,0,10">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Top" Width="46" Height="46" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><Path Data="M4,2 L20,2 L20,22 L4,22 Z M7,8 L17,8 M7,12 L17,12 M7,16 L14,16" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Width="27" Height="27" Stretch="Uniform" IsHitTestVisible="False" /></Border>
                        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,5" Text="报错日志分析" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Text="从报错日志中整理线索，缩小排查范围" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock DockPanel.Dock="Top" Text="尚未开放" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        <Button DockPanel.Dock="Bottom" Margin="-9,2,0,0" Content="进入排查→" Command="{Binding OpenConflictSectionCommand}" CommandParameter="logs" Style="{StaticResource EntranceActionStyle}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,10,0">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Top" Width="46" Height="46" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><Path Data="M12,2 L22,6 L20,17 L12,23 L4,17 L2,6 Z M7,12 L11,16 L17,8" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Width="27" Height="27" Stretch="Uniform" IsHitTestVisible="False" /></Border>
                        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,5" Text="健康性检查" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Text="检查文件结构、读取状态与未完成项" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock DockPanel.Dock="Top" Text="尚未开放" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        <Button DockPanel.Dock="Bottom" Margin="-9,2,0,0" Content="进入排查→" Command="{Binding OpenConflictSectionCommand}" CommandParameter="health" Style="{StaticResource EntranceActionStyle}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="10,10,0,0">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Top" Width="46" Height="46" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><Path Data="M12,2 L12,8 M12,8 L4,13 M12,8 L20,13 M4,13 L4,22 M20,13 L20,22" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Width="27" Height="27" Stretch="Uniform" IsHitTestVisible="False" /></Border>
                        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,5" Text="二分排查" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Text="分批试运行，根据反馈逐步缩小范围" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock DockPanel.Dock="Top" Text="尚未开放" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        <Button DockPanel.Dock="Bottom" Margin="-9,2,0,0" Content="进入排查→" Command="{Binding OpenConflictSectionCommand}" CommandParameter="bisect" Style="{StaticResource EntranceActionStyle}" />
                    </DockPanel>
                </Border>
            </UniformGrid>
        </Grid>
        <StackPanel Margin="28,18" Visibility="{Binding IsConflictUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Content="← 返回冲突检测" Command="{Binding ConflictBackCommand}" Style="{StaticResource HeaderBackButtonStyle}" HorizontalAlignment="Left" />
            <TextBlock Margin="0,28,0,12" Text="{Binding ConflictUnavailableTitle}" FontSize="23" FontWeight="SemiBold" />
            <Border Style="{StaticResource CardStyle}"><TextBlock Text="尚未开放" Foreground="{StaticResource MutedBrush}" /></Border>
        </StackPanel>
        <Grid Margin="28,18,28,28" Visibility="{Binding IsConflictBasic, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="31*" MinWidth="300" /><ColumnDefinition Width="16" /><ColumnDefinition Width="69*" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Button Content="← 返回冲突检测" Command="{Binding ConflictBackCommand}" Style="{StaticResource HeaderBackButtonStyle}" HorizontalAlignment="Left" />
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="检查范围" FontSize="18" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="＋ 添加" Command="{Binding AddSourceCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" />
                        </Grid>
                        <Border Grid.Row="1" Margin="0,16,0,12" Padding="12" Background="#EAE7E2" CornerRadius="4">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="当前 Mods 文件夹" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding ModsRootDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModsRootDisplay}" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="不可访问" FontSize="10" Foreground="#9A6A32" Visibility="{Binding HasModsRootAvailabilityWarning, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                                <Button Grid.Column="1" Content="{Binding ModsRootActionText}" Command="{Binding ChangeModsRootCommand}" Style="{StaticResource HeaderBackButtonStyle}" Padding="6,2" Foreground="#A892C5" FontSize="12" FontWeight="Normal" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="ConflictSourcesList" Grid.Row="2" ItemsSource="{Binding Sources}" Style="{StaticResource ConflictListStyle}"><ListBox.ItemTemplate><DataTemplate>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <CheckBox Margin="0,3,10,0" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding DataContext.CanEditSources, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding AvailabilityText}" Foreground="#9A6A32" FontSize="10" Visibility="{Binding HasAvailabilityWarning, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                                    <Button Grid.Column="2" Content="×" Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource HeaderBackButtonStyle}" Padding="8,2" />
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate></ListBox>
                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <ProgressBar Height="7" Maximum="{Binding ConflictProgressMaximum, Mode=OneWay}" Value="{Binding ConflictCompleted, Mode=OneWay}" IsIndeterminate="{Binding ConflictIndeterminate, Mode=OneWay}" Visibility="{Binding IsConflictScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                                <TextBlock Text="{Binding ConflictStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="ConflictProgressText" Text="{Binding ConflictProgressText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" FontWeight="Normal" />
                            </StackPanel>
                            <TextBlock Text="{Binding ConflictPhase}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            <Button Margin="0,14,0,0" Content="开始扫描" Command="{Binding StartConflictScanCommand}" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding IsConflictNotScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Margin="0,14,0,0" Content="取消扫描" Command="{Binding CancelConflictScanCommand}" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsConflictScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="20,16,20,12"><TextBlock Text="扫描结果" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Content="资源" Command="{Binding SelectConflictViewCommand}" CommandParameter="resources" Tag="{Binding IsResourceViewSelected}" Style="{StaticResource ConflictChoiceStyle}" Margin="0,0,12,0" />
                            <Button Content="脚本" Command="{Binding SelectConflictViewCommand}" CommandParameter="scripts" Tag="{Binding IsScriptViewSelected}" Style="{StaticResource ConflictChoiceStyle}" Margin="0,0,12,0" />
                            <Button Content="未完成" Command="{Binding SelectConflictViewCommand}" CommandParameter="problems" Tag="{Binding IsProblemViewSelected}" Style="{StaticResource ConflictChoiceStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,4,20,8" Visibility="{Binding ShowConflictFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="全部" Command="{Binding SelectConflictFilterCommand}" CommandParameter="all" Tag="{Binding IsAllFilterSelected}" Style="{StaticResource ConflictChoiceStyle}" Margin="0,0,5,0" />
                        <Button Content="需查看" Command="{Binding SelectConflictFilterCommand}" CommandParameter="different" Tag="{Binding IsDifferentFilterSelected}" Style="{StaticResource ConflictChoiceStyle}" Margin="0,0,5,0" />
                        <Button Content="可整理" Command="{Binding SelectConflictFilterCommand}" CommandParameter="same" Tag="{Binding IsSameFilterSelected}" Style="{StaticResource ConflictChoiceStyle}" Margin="0,0,5,0" />
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="20,0,20,0">
                        <TextBlock Text="{Binding ConflictStatus}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowConflictPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ListBox x:Name="ConflictRowsList" ItemsSource="{Binding ConflictRows}" ItemTemplate="{StaticResource ConflictRowTemplate}" Style="{StaticResource ConflictListStyle}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title, Mode=OneWay}" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding Key, Mode=OneWay}" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyConflictText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyConflictRows, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="20,10,20,12"><TextBlock Text="{Binding ConflictStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" /><TextBlock Text="没查出冲突不代表没有冲突" Visibility="{Binding ShowConflictWarning, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#9A6A32" FontSize="11" /></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>


