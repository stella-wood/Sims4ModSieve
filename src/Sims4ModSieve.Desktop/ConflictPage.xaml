<UserControl x:Class="Sims4ModSieve.Desktop.ConflictPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ConflictFilterButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="HitArea" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="EntranceActionStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitArea" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HitArea" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConflictTechnicalButtonStyle" TargetType="Button" BasedOn="{StaticResource EntranceActionStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="AutomationProperties.Name" Value="{Binding ExpandName, Mode=OneWay}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Key, Mode=OneWay}" />
        </Style>
        <Style x:Key="ConflictListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value><Style TargetType="ListBoxItem"><Setter Property="Focusable" Value="False" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="ConflictNeedReviewBrush" Color="#D33C2E" />
        <SolidColorBrush x:Key="ConflictCanOrganizeBrush" Color="#D99316" />
        <SolidColorBrush x:Key="ConflictIncompleteBrush" Color="#948C84" />
        <Style x:Key="ConflictQuickFilterStyle" TargetType="Button">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Border x:Name="Underline" Height="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="8,0,8,0" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter TargetName="Underline" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter TargetName="Underline" Property="Visibility" Value="Visible" /></Trigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter TargetName="Underline" Property="Visibility" Value="Visible" /></DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ConflictAllFilterStyle" TargetType="Button" BasedOn="{StaticResource ConflictQuickFilterStyle}">
            <Setter Property="Padding" Value="0,3,8,3" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ConflictExpandButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="ToolTip" Value="展开" />
            <Setter Property="AutomationProperties.Name" Value="{Binding ExpandName, Mode=OneWay}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Key, Mode=OneWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HitArea" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Path x:Name="Arrow" Data="M6,3 L11,8 L6,13" Width="16" Height="16" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HitArea" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="ToolTip" Value="收起" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="ConflictRowTemplate">
            <Border x:Name="Row" Background="{StaticResource SurfaceBrush}" BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border x:Name="RowContent" Padding="12,5">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button x:Name="ExpandButton" VerticalAlignment="Top" Style="{StaticResource ConflictExpandButtonStyle}"
                                    Visibility="{Binding IsExpandable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Command="{Binding DataContext.ToggleConflictExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            <StackPanel x:Name="ContentPanel" Grid.Column="1" Margin="5,3,8,3">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="GroupLabel" Grid.Column="1" Text="{Binding GroupLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,3,9,0"
                                               Visibility="{Binding IsCardStart, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Ellipse x:Name="StateDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{StaticResource ConflictIncompleteBrush}"
                                             Visibility="{Binding HasState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock x:Name="Title" Grid.Column="2" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}" />
                                </Grid>
                                <TextBlock x:Name="Detail" Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}" Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="11" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" Margin="0,0,3,0"
                                       Visibility="{Binding HasState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button x:Name="TechnicalAction" Grid.ColumnSpan="3" HorizontalAlignment="Right" Content="技术详情"
                                    Style="{StaticResource ConflictTechnicalButtonStyle}" Visibility="Collapsed"
                                    Command="{Binding DataContext.ToggleConflictExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                    <Line x:Name="GroupSeparator" Grid.Row="1" Height="1" Margin="20,10,0,1" X1="0" X2="1" Stretch="Fill"
                          Stroke="#D8D3CC" StrokeDashArray="2,4" StrokeThickness="1" Opacity="0.78" SnapsToDevicePixels="True"
                          Visibility="{Binding IsCardEnd, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCardStart}" Value="True">
                    <Setter TargetName="Row" Property="Margin" Value="0,8,0,0" />
                    <Setter TargetName="RowContent" Property="Padding" Value="12,9" />
                    <Setter TargetName="Title" Property="FontSize" Value="15" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="File"><Setter TargetName="RowContent" Property="Background" Value="#F3F1ED" /><Setter TargetName="RowContent" Property="Padding" Value="12,7" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Content"><Setter TargetName="RowContent" Property="Background" Value="#F3F1ED" /><Setter TargetName="Title" Property="FontSize" Value="11" /><Setter TargetName="Title" Property="FontWeight" Value="Normal" /><Setter TargetName="Title" Property="Foreground" Value="{StaticResource MutedBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Technical"><Setter TargetName="Title" Property="FontWeight" Value="Normal" /><Setter TargetName="Title" Property="FontSize" Value="10" /><Setter TargetName="Title" Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter TargetName="Title" Property="TextWrapping" Value="Wrap" /><Setter TargetName="Title" Property="TextTrimming" Value="None" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Explanation"><Setter TargetName="Title" Property="FontWeight" Value="Normal" /><Setter TargetName="Title" Property="TextWrapping" Value="Wrap" /><Setter TargetName="RowContent" Property="Padding" Value="12,9" /></DataTrigger>
                <DataTrigger Binding="{Binding IsTechnicalToggle}" Value="True"><Setter TargetName="ExpandButton" Property="Visibility" Value="Collapsed" /><Setter TargetName="ContentPanel" Property="Visibility" Value="Collapsed" /><Setter TargetName="TechnicalAction" Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="NeedsReview"><Setter TargetName="StateDot" Property="Fill" Value="{StaticResource ConflictNeedReviewBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="CanOrganize"><Setter TargetName="StateDot" Property="Fill" Value="{StaticResource ConflictCanOrganizeBrush}" /></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{StaticResource WindowBrush}">
        <Grid Margin="70,38,100,30" Visibility="{Binding IsConflictOverview, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="Mod 冲突检测" FontSize="35" Style="{StaticResource DisplayTextStyle}" />
            <TextBlock Grid.Row="1" Margin="0,10,0,26" Text="选择一种排查方式" FontSize="16" Foreground="{StaticResource MutedBrush}" />
            <UniformGrid Grid.Row="2" Columns="2" Rows="2">
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,10,10">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Top" Width="46" Height="46" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><Path Data="M2,12 L7,3 L13,12 L18,3 L23,12" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.8" Width="27" Height="27" Stretch="Uniform" IsHitTestVisible="False" /></Border>
                        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,5" Text="基础排查" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Text="比较资源覆盖与脚本模块，查看内容差异" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Button DockPanel.Dock="Bottom" Margin="-9,2,0,0" Content="进入排查→" Command="{Binding OpenConflictSectionCommand}" CommandParameter="basic" Style="{StaticResource EntranceActionStyle}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="10,0,0,10">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Top" Width="46" Height="46" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><Path Data="M4,2 L20,2 L20,22 L4,22 Z M7,8 L17,8 M7,12 L17,12 M7,16 L14,16" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Width="27" Height="27" Stretch="Uniform" IsHitTestVisible="False" /></Border>
                        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,5" Text="报错日志分析" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Text="从报错日志中整理线索，缩小排查范围" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock DockPanel.Dock="Top" Text="尚未开放" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        <Button DockPanel.Dock="Bottom" Margin="-9,2,0,0" Content="进入排查→" Command="{Binding OpenConflictSectionCommand}" CommandParameter="logs" Style="{StaticResource EntranceActionStyle}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,10,10,0">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Top" Width="46" Height="46" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><Path Data="M12,2 L22,6 L20,17 L12,23 L4,17 L2,6 Z M7,12 L11,16 L17,8" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Width="27" Height="27" Stretch="Uniform" IsHitTestVisible="False" /></Border>
                        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,5" Text="健康性检查" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Text="检查文件结构、读取状态与未完成项" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock DockPanel.Dock="Top" Text="尚未开放" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        <Button DockPanel.Dock="Bottom" Margin="-9,2,0,0" Content="进入排查→" Command="{Binding OpenConflictSectionCommand}" CommandParameter="health" Style="{StaticResource EntranceActionStyle}" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="12" Margin="10,10,0,0">
                    <DockPanel LastChildFill="False">
                        <Border DockPanel.Dock="Top" Width="46" Height="46" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left"><Path Data="M12,2 L12,8 M12,8 L4,13 M12,8 L20,13 M4,13 L4,22 M20,13 L20,22" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Width="27" Height="27" Stretch="Uniform" IsHitTestVisible="False" /></Border>
                        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,5" Text="二分排查" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Top" Text="分批试运行，根据反馈逐步缩小范围" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock DockPanel.Dock="Top" Text="尚未开放" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        <Button DockPanel.Dock="Bottom" Margin="-9,2,0,0" Content="进入排查→" Command="{Binding OpenConflictSectionCommand}" CommandParameter="bisect" Style="{StaticResource EntranceActionStyle}" />
                    </DockPanel>
                </Border>
            </UniformGrid>
        </Grid>
        <StackPanel Margin="28,18" Visibility="{Binding IsConflictUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Content="← 返回冲突检测" Command="{Binding ConflictBackCommand}" Style="{StaticResource HeaderBackButtonStyle}" HorizontalAlignment="Left" />
            <TextBlock Margin="0,28,0,12" Text="{Binding ConflictUnavailableTitle}" FontSize="23" FontWeight="SemiBold" />
            <Border Style="{StaticResource CardStyle}"><TextBlock Text="尚未开放" Foreground="{StaticResource MutedBrush}" /></Border>
        </StackPanel>
        <Grid Margin="28,18,28,28" Visibility="{Binding IsConflictBasic, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="31*" MinWidth="300" /><ColumnDefinition Width="16" /><ColumnDefinition Width="69*" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Button Content="← 返回冲突检测" Command="{Binding ConflictBackCommand}" Style="{StaticResource HeaderBackButtonStyle}" HorizontalAlignment="Left" />
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="检查范围" FontSize="18" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Content="＋ 添加" Command="{Binding AddSourceCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" />
                        </Grid>
                        <Border Grid.Row="1" Margin="0,16,0,12" Padding="12" Background="#EAE7E2" CornerRadius="4">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"><TextBlock Text="当前 Mods 文件夹" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding ModsRootDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModsRootDisplay}" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="不可访问" FontSize="10" Foreground="#9A6A32" Visibility="{Binding HasModsRootAvailabilityWarning, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                                <Button Grid.Column="1" Content="{Binding ModsRootActionText}" Command="{Binding ChangeModsRootCommand}" Style="{StaticResource HeaderBackButtonStyle}" Padding="6,2" Foreground="#A892C5" FontSize="12" FontWeight="Normal" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="ConflictSourcesList" Grid.Row="2" ItemsSource="{Binding Sources}" Style="{StaticResource ConflictListStyle}"><ListBox.ItemTemplate><DataTemplate>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <CheckBox Margin="0,3,10,0" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding DataContext.CanEditSources, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding AvailabilityText}" Foreground="#9A6A32" FontSize="10" Visibility="{Binding HasAvailabilityWarning, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                                    <Button Grid.Column="2" Content="×" Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource HeaderBackButtonStyle}" Padding="8,2" />
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate></ListBox>
                        <StackPanel Grid.Row="3" Margin="0,12,0,0">
                            <ProgressBar Height="7" Maximum="{Binding ConflictProgressMaximum, Mode=OneWay}" Value="{Binding ConflictCompleted, Mode=OneWay}" IsIndeterminate="{Binding ConflictIndeterminate, Mode=OneWay}" Visibility="{Binding IsConflictScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                                <TextBlock Text="{Binding ConflictStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="ConflictProgressText" Text="{Binding ConflictProgressText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" FontWeight="Normal" />
                            </StackPanel>
                            <TextBlock Text="{Binding ConflictPhase}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            <Button Margin="0,14,0,0" Content="开始扫描" Command="{Binding StartConflictScanCommand}" Style="{StaticResource PrimaryButtonStyle}" Visibility="{Binding IsConflictNotScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Margin="0,14,0,0" Content="取消扫描" Command="{Binding CancelConflictScanCommand}" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding IsConflictScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="扫描结果" FontSize="18" FontWeight="SemiBold" Margin="20,16,20,3.48" />
                    <Border x:Name="ConflictQuickFilterBar" Grid.Row="1" Height="32" Background="Transparent" BorderThickness="0,0,0,1" Padding="18,0,0,0" Margin="20,0,20,8">
                        <Border.BorderBrush><SolidColorBrush Color="#2B2927" Opacity="0.2" /></Border.BorderBrush>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsConflictNotScanning}">
                            <Button x:Name="ConflictAllFilter" Content="全部" Command="{Binding SelectConflictFilterCommand}" CommandParameter="all" Style="{StaticResource ConflictAllFilterStyle}" Margin="0,0,8,0" AutomationProperties.Name="全部" />
                            <Button x:Name="ConflictNeedsReviewFilter" Tag="{Binding IsDifferentFilterSelected}" Command="{Binding SelectConflictFilterCommand}" CommandParameter="different" Style="{StaticResource ConflictQuickFilterStyle}" Margin="0,0,8,0" AutomationProperties.Name="需查看">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{StaticResource ConflictNeedReviewBrush}" Margin="0,0,6,0" /><TextBlock Text="需查看" /></StackPanel>
                            </Button>
                            <Button x:Name="ConflictCanOrganizeFilter" Tag="{Binding IsSameFilterSelected}" Command="{Binding SelectConflictFilterCommand}" CommandParameter="same" Style="{StaticResource ConflictQuickFilterStyle}" Margin="0,0,8,0" AutomationProperties.Name="可整理">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{StaticResource ConflictCanOrganizeBrush}" Margin="0,0,6,0" /><TextBlock Text="可整理" /></StackPanel>
                            </Button>
                            <Button x:Name="ConflictIncompleteFilter" Tag="{Binding IsIncompleteFilterSelected}" Command="{Binding SelectConflictFilterCommand}" CommandParameter="incomplete" Style="{StaticResource ConflictQuickFilterStyle}" AutomationProperties.Name="未完成">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{StaticResource ConflictIncompleteBrush}" Margin="0,0,6,0" /><TextBlock Text="未完成" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <ToggleButton x:Name="ConflictFilterButton" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ConflictFilterButtonStyle}"
                                      IsEnabled="{Binding IsConflictNotScanning}" ToolTip="筛选结果" AutomationProperties.Name="筛选结果">
                            <Grid Width="16" Height="16" IsHitTestVisible="False">
                                <Path Data="M1,2 L15,2 L10,8 L10,14 L6,12 L6,8 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.3" StrokeLineJoin="Round" />
                                <Ellipse Width="4" Height="4" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Visibility="{Binding HasActiveConflictFilter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </ToggleButton>
                        <Popup PlacementTarget="{Binding ElementName=ConflictFilterButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=ConflictFilterButton, Mode=TwoWay}"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10" MinWidth="260">
                                <StackPanel>
                                    <UniformGrid x:Name="ConflictStatusChoices" Columns="3">
                                        <CheckBox Content="全部" IsChecked="{Binding IncludeAllConflictStates}" Margin="0,4,10,4" AutomationProperties.Name="全部状态" />
                                        <CheckBox Content="需查看" IsChecked="{Binding IncludeConflictNeedsReview}" Margin="0,4,10,4" />
                                        <CheckBox Content="可整理" IsChecked="{Binding IncludeConflictCanOrganize}" Margin="0,4,10,4" />
                                        <CheckBox Content="未完成" IsChecked="{Binding IncludeConflictIncomplete}" Margin="0,4,10,4" />
                                    </UniformGrid>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,4" />
                                    <UniformGrid x:Name="ConflictTypeChoices" Columns="3">
                                        <CheckBox Content="全部" IsChecked="{Binding IncludeAllConflictTypes}" Margin="0,4,10,4" AutomationProperties.Name="全部类型" />
                                        <CheckBox Content="资源" IsChecked="{Binding IncludeConflictResources}" Margin="0,4,10,4" />
                                        <CheckBox Content="脚本" IsChecked="{Binding IncludeConflictScripts}" Margin="0,4,10,4" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Popup>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="20,0,20,0">
                        <TextBlock Text="{Binding ConflictStatus}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowConflictPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ListBox x:Name="ConflictRowsList" ItemsSource="{Binding ConflictRows}" ItemTemplate="{StaticResource ConflictRowTemplate}" Style="{StaticResource ConflictListStyle}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title, Mode=OneWay}" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding Key, Mode=OneWay}" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyConflictText}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowEmptyConflictRows, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="20,10,20,12"><TextBlock Text="没查出冲突不代表没有冲突" Visibility="{Binding ShowConflictWarning, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="#9A6A32" FontSize="11" /></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>


