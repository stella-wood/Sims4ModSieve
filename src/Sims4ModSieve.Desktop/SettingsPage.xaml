<UserControl x:Class="Sims4ModSieve.Desktop.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Sims4ModSieve.Desktop.Services"
             Background="White" FontFamily="Microsoft YaHei UI" FontSize="13"
             Foreground="{StaticResource InkBrush}" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingsDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#89847E" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsFeedback" TargetType="TextBlock" BasedOn="{StaticResource SettingsDescription}">
            <Setter Property="Foreground" Value="#9A6A32" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,38" />
        </Style>
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#F2F1EF" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Host" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Host" Property="Background" Value="#ECEAE7" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Host" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource HoverTextBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsNav" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="GroupName" Value="SettingsSections" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Host" Background="Transparent" CornerRadius="6" Padding="11,0"
                                    BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Host" Property="Background" Value="#ECEAE7" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Host" Property="Background" Value="#F0EEEB" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Host" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavIcon" TargetType="Path">
            <Setter Property="Width" Value="17" /><Setter Property="Height" Value="17" />
            <Setter Property="Stroke" Value="#55514C" /><Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="Stretch" Value="Uniform" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="SettingsGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="#F0EEEB" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" /><Setter Property="Padding" Value="20,0" />
        </Style>
        <Style x:Key="SettingsPath" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="DiagnosticText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="14,12,42,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#44403C" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Style.Resources>
                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Width="6" HorizontalAlignment="Right" Margin="0,3,2,3" Background="Transparent">
                                    <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                           Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb MinHeight="24">
                                                <Thumb.Style>
                                                    <Style TargetType="Thumb">
                                                        <Setter Property="Background" Value="#D8D3CC" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B2ABA3" /></Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Thumb.Style>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3" /></ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="DiagnosticFrame" TargetType="Border" BasedOn="{StaticResource SettingsGroup}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="280" />
        </Style>
        <Style x:Key="DiagnosticCopyButton" TargetType="Button" BasedOn="{StaticResource BareIconButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,9,16,0" />
        </Style>
        <Style x:Key="DiagnosticFolderButton" TargetType="Button" BasedOn="{StaticResource BareIconButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DiagnosticRefreshButton" TargetType="Button" BasedOn="{StaticResource SettingsTextButton}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <DataTemplate x:Key="FolderCandidateTemplate">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="使用此目录" Style="{StaticResource SettingsTextButton}" Margin="0,0,14,0"
                            Command="{Binding DataContext.ApplyDefaultFolderCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button Content="取消" Style="{StaticResource SettingsTextButton}"
                            Command="{Binding DataContext.CancelDefaultFolderCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#F8F7F5" BorderBrush="#E7E4E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,26,12,0" KeyboardNavigation.TabNavigation="Continue">
                <TextBlock Text="设置" FontSize="19" FontWeight="SemiBold" Margin="10,0,0,28" />
                <RadioButton x:Name="FoldersSectionButton" Style="{StaticResource SettingsNav}" AutomationProperties.Name="常规"
                             IsChecked="{Binding IsFoldersSettings, Mode=TwoWay}" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="folders">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource SettingsNavIcon}" Data="M 9.92,2.22 L 14.08,2.22 L 14.53,5.05 L 16.76,6.33 L 19.43,5.31 L 21.51,8.91 L 19.29,10.72 L 19.29,13.28 L 21.51,15.09 L 19.43,18.69 L 16.76,17.67 L 14.53,18.95 L 14.08,21.78 L 9.92,21.78 L 9.47,18.95 L 7.24,17.67 L 4.57,18.69 L 2.49,15.09 L 4.71,13.28 L 4.71,10.72 L 2.49,8.91 L 4.57,5.31 L 7.24,6.33 L 9.47,5.05 Z M 15.3,12 A 3.3,3.3 0 1 1 8.7,12 A 3.3,3.3 0 1 1 15.3,12 Z" />
                        <TextBlock Text="常规" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="DiagnosticsSectionButton" Style="{StaticResource SettingsNav}" AutomationProperties.Name="诊断与反馈"
                             IsChecked="{Binding IsDiagnosticsSettings, Mode=TwoWay}" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="diagnostics">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource SettingsNavIcon}" Data="M 3,3 L 19,3 L 19,15 L 10,15 L 5,19 L 5,15 L 3,15 Z M 7,7 L 15,7 M 7,11 L 12,11" />
                        <TextBlock Text="诊断与反馈" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="AboutSectionButton" Style="{StaticResource SettingsNav}" AutomationProperties.Name="关于"
                             IsChecked="{Binding IsAboutSettings, Mode=TwoWay}" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="about">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource SettingsNavIcon}" Data="M 11,2 A 9,9 0 1 1 10.99,2 M 11,6 L 11,7 M 11,10 L 11,16" />
                        <TextBlock Text="关于" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                      ScrollChanged="SettingsContentScroll_ScrollChanged">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Width" Value="12" />
                    <Setter Property="Opacity" Value="0" />
                    <EventSetter Event="Loaded" Handler="OuterScrollBar_Loaded" />
                    <EventSetter Event="Unloaded" Handler="OuterScrollBar_Unloaded" />
                    <EventSetter Event="MouseEnter" Handler="OuterScrollBar_Activity" />
                    <EventSetter Event="MouseLeave" Handler="OuterScrollBar_Activity" />
                    <EventSetter Event="GotMouseCapture" Handler="OuterScrollBar_Activity" />
                    <EventSetter Event="LostMouseCapture" Handler="OuterScrollBar_Activity" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Width="12" Background="Transparent">
                                    <Track x:Name="PART_Track" Width="12" Margin="0,12,0,12" Orientation="Vertical" IsDirectionReversed="True"
                                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                           Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb x:Name="ScrollThumb" MinHeight="24" Background="#E8E5E1">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid Background="Transparent">
                                                            <Border Width="4" HorizontalAlignment="Right" Margin="0,0,4,0"
                                                                    Background="{TemplateBinding Background}" CornerRadius="2" IsHitTestVisible="False" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="#C8C1B8" /></Trigger>
                                    <Trigger SourceName="ScrollThumb" Property="IsDragging" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="#C8C1B8" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="36,50" />
                        <Setter Property="MaxWidth" Value="760" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDiagnosticsSettings}" Value="True">
                                <Setter Property="Margin" Value="88,52,88,50" />
                                <Setter Property="MaxWidth" Value="Infinity" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel Visibility="{Binding IsFoldersSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="常规" Style="{StaticResource SettingsTitle}" />
                    <TextBlock Text="游戏文件夹" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <StackPanel>
                            <Grid Margin="0,20,0,17">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,3,18,0">
                                    <TextBlock Text="默认 Mods 文件夹" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="各检测共用的默认位置" Style="{StaticResource SettingsDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ModsRootDisplay}" ToolTip="{Binding ModsRoot}" Style="{StaticResource SettingsPath}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="OpenModsButton" Content="打开文件夹" Style="{StaticResource SettingsButton}" Margin="0,0,10,0" Command="{Binding OpenModsFolderCommand}" />
                                            <Button x:Name="ChangeDefaultModsButton" Content="更改" Style="{StaticResource SettingsButton}" Command="{Binding ChangeDefaultModsRootCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="文件夹不可访问" Style="{StaticResource SettingsFeedback}" HorizontalAlignment="Right" Visibility="{Binding HasModsRootAvailabilityWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button x:Name="FindModsButton" Content="重新查找默认目录" Style="{StaticResource SettingsTextButton}" HorizontalAlignment="Right" Margin="0,10,0,0" Command="{Binding FindDefaultFolderCommand}" CommandParameter="Mods" />
                                    <TextBlock Text="{Binding ModsFolderFeedback}" Style="{StaticResource SettingsFeedback}" />
                                    <ContentControl Content="{Binding FolderCandidate}" ContentTemplate="{StaticResource FolderCandidateTemplate}" Visibility="{Binding HasModsFolderCandidate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                            <Border Background="#ECE9E5" Height="1" />
                            <Grid Margin="0,20,0,17">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,3,18,0">
                                    <TextBlock Text="Tray 文件夹" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="用于图库检测，当前尚未开放" Style="{StaticResource SettingsDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TrayRootDisplay}" ToolTip="{Binding TrayRoot}" Style="{StaticResource SettingsPath}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="OpenTrayButton" Content="打开文件夹" Style="{StaticResource SettingsButton}" Margin="0,0,10,0" Command="{Binding OpenTrayFolderCommand}" Visibility="{Binding HasTrayRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button x:Name="ChangeTrayButton" Content="{Binding TrayRootActionText}" Style="{StaticResource SettingsButton}" Command="{Binding ChangeTrayRootCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="文件夹不可访问" Style="{StaticResource SettingsFeedback}" HorizontalAlignment="Right" Visibility="{Binding HasTrayRootAvailabilityWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button x:Name="FindTrayButton" Content="重新查找默认目录" Style="{StaticResource SettingsTextButton}" Command="{Binding FindDefaultFolderCommand}" CommandParameter="Tray" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding TrayFolderFeedback}" Style="{StaticResource SettingsFeedback}" />
                                    <ContentControl Content="{Binding FolderCandidate}" ContentTemplate="{StaticResource FolderCandidateTemplate}" Visibility="{Binding HasTrayFolderCandidate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding SettingsFeedback}" Style="{StaticResource SettingsFeedback}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsDiagnosticsSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="诊断与反馈" Style="{StaticResource SettingsTitle}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="最近一次扫描计时" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="OpenScanTimingFolderButton" Grid.Column="1" Style="{StaticResource DiagnosticFolderButton}" Command="{Binding OpenLogFolderCommand}"
                                AutomationProperties.Name="打开扫描计时日志文件夹" ToolTip="打开扫描计时日志文件夹">
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"
                                  Data="M 2,18 L 2,5 L 7,5 L 9,7 L 18,7 L 18,10 M 2,18 L 5.5,10 L 21,10 L 17.5,18 Z" />
                        </Button>
                        <Button x:Name="RefreshScanTimingButton" Grid.Column="2" Content="刷新" Style="{StaticResource DiagnosticRefreshButton}"
                                HorizontalAlignment="Right" Command="{Binding RefreshDiagnosticsCommand}" AutomationProperties.Name="刷新扫描计时" />
                    </Grid>
                    <Border x:Name="ScanTimingFrame" Margin="0,0,0,28">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DiagnosticFrame}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanTimingEmpty}" Value="True">
                                        <Setter Property="Height" Value="Auto" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBox x:Name="ScanTimingSummary" Text="{Binding ScanTimingText, Mode=OneWay}" Style="{StaticResource DiagnosticText}" />
                            <Button x:Name="CopyScanTimingButton" Style="{StaticResource DiagnosticCopyButton}" Command="{Binding CopyScanTimingCommand}"
                                    AutomationProperties.Name="复制扫描计时" ToolTip="复制扫描计时">
                                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"
                                      Data="M 5.5,5.5 L 13.5,5.5 L 13.5,14.5 L 5.5,14.5 Z M 10.5,3.5 L 10.5,1.5 L 1.5,1.5 L 1.5,10.5 L 3.5,10.5" />
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="错误记录" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="OpenDiagnosticLogFolderButton" Grid.Column="1" Style="{StaticResource DiagnosticFolderButton}" Command="{Binding OpenLogFolderCommand}"
                                AutomationProperties.Name="打开错误日志文件夹" ToolTip="打开错误日志文件夹">
                            <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"
                                  Data="M 2,18 L 2,5 L 7,5 L 9,7 L 18,7 L 18,10 M 2,18 L 5.5,10 L 21,10 L 17.5,18 Z" />
                        </Button>
                        <Button x:Name="RefreshDiagnosticLogsButton" Grid.Column="2" Content="刷新" Style="{StaticResource DiagnosticRefreshButton}"
                                HorizontalAlignment="Right" Command="{Binding RefreshDiagnosticsCommand}" AutomationProperties.Name="刷新错误记录" />
                    </Grid>
                    <Border x:Name="DiagnosticLogFrame">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource DiagnosticFrame}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoDiagnosticErrors}" Value="True">
                                        <Setter Property="Height" Value="Auto" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <TextBox x:Name="DiagnosticLogSummary" Text="{Binding DiagnosticText, Mode=OneWay}" Style="{StaticResource DiagnosticText}" />
                            <Button x:Name="CopyDiagnosticsButton" Style="{StaticResource DiagnosticCopyButton}" Command="{Binding CopyDiagnosticsCommand}"
                                    AutomationProperties.Name="复制诊断信息" ToolTip="复制诊断信息">
                                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"
                                      Data="M 5.5,5.5 L 13.5,5.5 L 13.5,14.5 L 5.5,14.5 Z M 10.5,3.5 L 10.5,1.5 L 1.5,1.5 L 1.5,10.5 L 3.5,10.5" />
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding DiagnosticsFeedback}" Style="{StaticResource SettingsFeedback}" />
                    <TextBlock Text="反馈问题" FontSize="15" FontWeight="SemiBold" Margin="0,32,0,0" />
                    <TextBlock Text="可附上诊断信息，帮助定位问题" Style="{StaticResource SettingsDescription}" />
                    <Button Content="前往 GitHub 反馈" Style="{StaticResource SettingsTextButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding OpenFeedbackCommand}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsAboutSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="关于" Style="{StaticResource SettingsTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource BrandMarkImage}" Width="38" Height="48" Margin="0,0,18,0" IsHitTestVisible="False" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sims 4 Mod Sieve" Style="{StaticResource BrandTextStyle}" FontSize="22" />
                            <TextBlock Text="{Binding ProductVersion, StringFormat=版本 {0}}" Style="{StaticResource SettingsDescription}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="本地离线的《模拟人生 4》Mod 整理工具" Style="{StaticResource SettingsDescription}" Margin="0,20,0,26" />
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="项目主页" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                        <Button Content="前往 GitHub" Style="{StaticResource SettingsTextButton}" HorizontalAlignment="Right" Command="{Binding OpenProjectCommand}"
                                ToolTip="{x:Static services:SettingsSupportService.ProjectUrl}" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="MIT 许可证" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                        <Button x:Name="LicenseButton" Content="查看许可证" Style="{StaticResource SettingsTextButton}" HorizontalAlignment="Right" Command="{Binding OpenLicenseCommand}" CommandParameter="LICENSE" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="第三方声明" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                        <Button x:Name="ThirdPartyNoticesButton" Content="查看声明" Style="{StaticResource SettingsTextButton}" HorizontalAlignment="Right" Command="{Binding OpenLicenseCommand}" CommandParameter="THIRD-PARTY-NOTICES.md" />
                    </Grid>
                    <TextBlock Text="{Binding AboutFeedback}" Style="{StaticResource SettingsFeedback}" />
                    <Border x:Name="LicenseFrame" Style="{StaticResource DiagnosticFrame}" Margin="0,20,0,0"
                            Visibility="{Binding HasLicenseText, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox x:Name="LicenseSummary" Text="{Binding LicenseText, Mode=OneWay}" Style="{StaticResource DiagnosticText}" Padding="14,12" />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
