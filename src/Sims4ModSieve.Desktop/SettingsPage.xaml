<UserControl x:Class="Sims4ModSieve.Desktop.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:duplicates="clr-namespace:Sims4ModSieve.Core.Duplicates;assembly=Sims4ModSieve.Core"
             xmlns:services="clr-namespace:Sims4ModSieve.Desktop.Services"
             xmlns:local="clr-namespace:Sims4ModSieve.Desktop"
             Background="White" FontFamily="Microsoft YaHei UI" FontSize="13"
             Foreground="{StaticResource InkBrush}" UseLayoutRounding="True">
    <UserControl.Resources>
        <sys:Double x:Key="ScanConcurrencyInfoSize">11</sys:Double>
        <sys:Double x:Key="ScanConcurrencyInfoTargetSize">24</sys:Double>
        <Thickness x:Key="ScanConcurrencyInfoGap">2,0,0,0</Thickness>
        <Thickness x:Key="SettingsSectionGap">0,36,0,0</Thickness>
        <Thickness x:Key="SettingsGroupRowInset">0,16,0,16</Thickness>
        <Thickness x:Key="ExternalDisabledLabelGap">6,0,0,0</Thickness>
        <Thickness x:Key="ExternalDisabledLabelPadding">6,0</Thickness>
        <CornerRadius x:Key="RadiusS">2</CornerRadius>
        <sys:Double x:Key="ExternalDisabledLabelSize">11</sys:Double>
        <sys:String x:Key="ExternalDisabledHelp">此文件在 Sieve 之外禁用。这里的时间是首次发现时间。如果是其他 Mod 管理器禁用的，在这里启用后，那个工具的记录可能对不上。</sys:String>
        <SolidColorBrush x:Key="SettingsButtonHoverBrush" Color="#ECEAE7" />
        <CornerRadius x:Key="RadiusM">4</CornerRadius>
        <sys:Double x:Key="CacheClearIconSize">12</sys:Double>
        <Thickness x:Key="CacheClearIconGap">0,0,4,0</Thickness>
        <SolidColorBrush x:Key="CacheClearCheckBrush" Color="#39734F" />
        <SolidColorBrush x:Key="UpdateFailureToastBrush" Color="#F8EFED" />
        <SolidColorBrush x:Key="UpdateFailureToastTextBrush" Color="#9F4944" />
        <SolidColorBrush x:Key="UpdateReleaseLinkBrush" Color="#8068A3" />
        <Thickness x:Key="UpdateFailureToastInset">16,32,16,0</Thickness>
        <Thickness x:Key="UpdateFailureToastPadding">12,8</Thickness>
        <sys:Double x:Key="AboutUpdatePopupGap">6</sys:Double>
        <Thickness x:Key="AboutUpdatePopupPadding">18,14</Thickness>
        <Thickness x:Key="AboutUpdatePopupVersionMargin">0,8,0,16</Thickness>
        <Thickness x:Key="AboutUpdatePopupRowMargin">0,0,0,8</Thickness>
        <Thickness x:Key="AboutUpdatePopupBorderThickness">1</Thickness>
        <sys:Double x:Key="AboutUpdatePopupMaxWidth">320</sys:Double>
        <sys:Double x:Key="AboutUpdatePopupProgressHeight">4</sys:Double>
        <Style x:Key="SettingsGroupDivider" TargetType="Border">
            <Setter Property="Background" Value="#ECE9E5" />
            <Setter Property="Height" Value="1" />
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="SettingsGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource SettingsLabel}">
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="SettingsDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#89847E" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsFeedback" TargetType="TextBlock" BasedOn="{StaticResource SettingsDescription}">
            <Setter Property="Foreground" Value="#9A6A32" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsTitle" TargetType="TextBlock" BasedOn="{StaticResource SettingsTitleTextStyle}">
            <Setter Property="Margin" Value="0,0,0,38" />
        </Style>
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#F2F1EF" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Host" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource RadiusM}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Host" Property="Background" Value="{StaticResource SettingsButtonHoverBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Host" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckUpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
            <Setter Property="AutomationProperties.Name" Value="检查更新" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource RadiusM}">
                            <Grid IsHitTestVisible="False">
                                <TextBlock x:Name="CheckUpdateLabel" Text="检查更新" HorizontalAlignment="Center" />
                                <StackPanel x:Name="CheckingUpdateLabel" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <Grid x:Name="CheckUpdateSpinner" Width="{StaticResource CacheClearIconSize}" Height="{StaticResource CacheClearIconSize}"
                                          Margin="{StaticResource CacheClearIconGap}" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5" IsVisibleChanged="SettingsSpinner_IsVisibleChanged">
                                        <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                                        <Path Data="M 6,1 A 5,5 0 1 1 1,6" Stroke="{TemplateBinding Foreground}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Grid>
                                    <TextBlock Text="检查中" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <StackPanel x:Name="CurrentUpdateLabel" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                                    <Grid Width="{StaticResource CacheClearIconSize}" Height="{StaticResource CacheClearIconSize}"
                                          Margin="{StaticResource CacheClearIconGap}" VerticalAlignment="Center">
                                        <Path Data="M 1.5,6 L 4.5,9 L 10.5,3" Stroke="{StaticResource CacheClearCheckBrush}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Grid>
                                    <TextBlock Text="已是最新版本" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Host" Property="Background" Value="{StaticResource SettingsButtonHoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="{StaticResource SettingsButtonHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsManualUpdateChecking}" Value="True">
                                <Setter TargetName="CheckUpdateLabel" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CheckingUpdateLabel" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsManualUpdateCurrent}" Value="True">
                                <Setter TargetName="CheckUpdateLabel" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CurrentUpdateLabel" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsManualUpdateChecking}" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="检查中" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsManualUpdateCurrent}" Value="True">
                    <Setter Property="AutomationProperties.Name" Value="已是最新版本" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClearCacheButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
            <Setter Property="AutomationProperties.Name" Value="清除缓存" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Host" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                    CornerRadius="{StaticResource RadiusM}">
                                <Grid IsHitTestVisible="False">
                                    <TextBlock x:Name="IdleLabel" Text="清除缓存" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" IsVisibleChanged="CacheClearContent_IsVisibleChanged" />
                                    <StackPanel x:Name="ClearingLabel" Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" Visibility="Hidden">
                                        <Grid x:Name="ClearSpinner" Width="{StaticResource CacheClearIconSize}" Height="{StaticResource CacheClearIconSize}"
                                              Margin="{StaticResource CacheClearIconGap}" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5" IsVisibleChanged="SettingsSpinner_IsVisibleChanged">
                                            <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                                            <Path Data="M 6,1 A 5,5 0 1 1 1,6" Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Grid>
                                        <TextBlock Text="正在清除" />
                                    </StackPanel>
                                    <StackPanel x:Name="ClearedLabel" Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" Visibility="Hidden"
                                                IsVisibleChanged="CacheClearContent_IsVisibleChanged">
                                        <Grid Width="{StaticResource CacheClearIconSize}" Height="{StaticResource CacheClearIconSize}"
                                              Margin="{StaticResource CacheClearIconGap}" VerticalAlignment="Center">
                                            <Path Data="M 1.5,6 L 4.5,9 L 10.5,3" Stroke="{StaticResource CacheClearCheckBrush}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Grid>
                                        <TextBlock Text="缓存已清除" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="{StaticResource SettingsButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Host" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <DataTrigger Binding="{Binding CacheClearStatus}" Value="Clearing">
                                <Setter TargetName="Host" Property="Opacity" Value="1" />
                                <Setter TargetName="IdleLabel" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="ClearingLabel" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CacheClearStatus}" Value="Cleared">
                                <Setter TargetName="Host" Property="Opacity" Value="1" />
                                <Setter TargetName="IdleLabel" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="ClearedLabel" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CacheClearStatus}" Value="Clearing">
                    <Setter Property="AutomationProperties.Name" Value="正在清除缓存" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CacheClearStatus}" Value="Cleared">
                    <Setter Property="AutomationProperties.Name" Value="缓存已清除" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ManagedBulkRestoreButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="#EEE8F4" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="13,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E3D9ED" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsTextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource HoverTextBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsNav" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="GroupName" Value="SettingsSections" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Host" Background="Transparent" CornerRadius="6" Padding="11,0"
                                    BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Host" Property="Background" Value="#ECEAE7" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Host" Property="Background" Value="#F0EEEB" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Host" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavIcon" TargetType="Path">
            <Setter Property="Width" Value="17" /><Setter Property="Height" Value="17" />
            <Setter Property="Stroke" Value="#55514C" /><Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="Stretch" Value="Uniform" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="SettingsGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="#F0EEEB" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" /><Setter Property="Padding" Value="20,0" />
        </Style>
        <Style x:Key="SettingsPath" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="DiagnosticText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="14,12,42,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#44403C" />
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Style.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ResultVerticalScrollBarStyle}" />
            </Style.Resources>
        </Style>
        <Style x:Key="DiagnosticFrame" TargetType="Border" BasedOn="{StaticResource SettingsGroup}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="280" />
        </Style>
        <Style x:Key="DiagnosticCopyButton" TargetType="Button" BasedOn="{StaticResource BareIconButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,9,16,0" />
        </Style>
        <Style x:Key="DiagnosticFolderButton" TargetType="Button" BasedOn="{StaticResource BareIconButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DiagnosticRefreshButton" TargetType="Button" BasedOn="{StaticResource SettingsTextButton}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <DataTemplate x:Key="FolderCandidateTemplate">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="使用此目录" Style="{StaticResource SettingsTextButton}" Margin="0,0,14,0"
                            Command="{Binding DataContext.ApplyDefaultFolderCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button Content="取消" Style="{StaticResource SettingsTextButton}"
                            Command="{Binding DataContext.CancelDefaultFolderCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="ManagedFileAction" TargetType="Button" BasedOn="{StaticResource SettingsTextButton}">
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <DataTemplate x:Key="ManagedFileTemplate">
            <Grid MinHeight="50" Margin="18,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48*" /><ColumnDefinition Width="18" />
                    <ColumnDefinition Width="16*" /><ColumnDefinition Width="18" />
                    <ColumnDefinition Width="17*" /><ColumnDefinition Width="18" />
                    <ColumnDefinition Width="19*" MinWidth="100" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <CheckBox Margin="0,0,14,0" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}"
                        Visibility="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExternalDisabled}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="{StaticResource RadiusS}" Padding="{StaticResource ExternalDisabledLabelPadding}"
                                ToolTip="{StaticResource ExternalDisabledHelp}" VerticalAlignment="Center"
                                Margin="{StaticResource ExternalDisabledLabelGap}"
                                Visibility="{Binding IsExternalDisabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="外部禁用" AutomationProperties.Name="外部禁用"
                                    AutomationProperties.HelpText="{StaticResource ExternalDisabledHelp}"
                                    Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource ExternalDisabledLabelSize}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Column="4" Text="{Binding TimeText}" ToolTip="{Binding TimeTooltip}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{StaticResource MutedBrush}" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{Binding RestoreText}" Style="{StaticResource ManagedFileAction}" Command="{Binding RestoreCommand}"
                        Visibility="{Binding CanRestore, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ManagedFileAction}"><Style.Triggers>
                            <DataTrigger Binding="{Binding CanRestore}" Value="True"><Setter Property="Margin" Value="8,0,0,0" /></DataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="删除" Style="{StaticResource ManagedFileAction}" Command="{Binding DeleteCommand}" ToolTip="{Binding Path}" Margin="8,0,0,0"
                        Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FileManagementSectionTemplate">
            <StackPanel TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="12">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SettingsGroupTitle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource DiagnosticFolderButton}" Command="{Binding OpenFolderCommand}" ToolTip="打开文件夹"
                        AutomationProperties.Name="{Binding Title, StringFormat=打开{0}}" Visibility="{Binding HasFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeLineJoin="Round" IsHitTestVisible="False"
                            Data="M 2,18 L 2,5 L 7,5 L 9,7 L 18,7 L 18,10 M 2,18 L 5.5,10 L 21,10 L 17.5,18 Z" />
                    </Button>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsMultiSelect, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="全选" Command="{Binding SelectAllCommand}" Style="{StaticResource ManagedFileAction}" Margin="0,0,20,0" />
                            <Button Content="清空勾选" Command="{Binding ClearSelectionCommand}" Style="{StaticResource ManagedFileAction}" Margin="0,0,20,0" />
                        </StackPanel>
                        <Button Content="{Binding MultiSelectText}" Command="{Binding ToggleMultiSelectCommand}" Style="{StaticResource SettingsButton}"
                            Visibility="{Binding HasMultiSelect, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="＋添加" Command="{Binding AddCommand}" Margin="20,0,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SettingsButton}">
                                <Setter Property="Visibility" Value="{Binding HasAdd, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsMultiSelect}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border BorderThickness="1" BorderBrush="#E8E8E8" CornerRadius="3" Background="White">
                    <StackPanel>
                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Visibility="{Binding HasFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Height="34" Margin="18,0,30,0" TextBlock.Foreground="{StaticResource MutedBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48*" /><ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="16*" /><ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="17*" /><ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="19*" MinWidth="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="文件" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiSelect}" Value="True"><Setter Property="Margin" Value="30,0,0,0" /></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="大小" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding TimeHeader}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="操作" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
