<UserControl x:Class="Sims4ModSieve.Desktop.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" FontFamily="Microsoft YaHei UI" FontSize="13"
             Foreground="{StaticResource InkBrush}" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SettingsDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#89847E" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsFeedback" TargetType="TextBlock" BasedOn="{StaticResource SettingsDescription}">
            <Setter Property="Foreground" Value="#9A6A32" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,38" />
        </Style>
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#F2F1EF" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Host" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                            <Border x:Name="FocusBorder" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Host" Property="Background" Value="#ECEAE7" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Host" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTextButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SettingsNav" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingsSections" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Host" Background="Transparent" CornerRadius="6" Padding="11,0"
                                    BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Host" Property="Background" Value="#ECEAE7" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Host" Property="Background" Value="#F0EEEB" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Host" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Host" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavIcon" TargetType="Path">
            <Setter Property="Width" Value="17" /><Setter Property="Height" Value="17" />
            <Setter Property="Stroke" Value="#55514C" /><Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="Stretch" Value="Uniform" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="SettingsGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="#F0EEEB" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" /><Setter Property="Padding" Value="20,0" />
        </Style>
        <Style x:Key="SettingsPath" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="SettingsLogExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Content="{TemplateBinding Header}" HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Host" Background="Transparent" Padding="2,5" BorderBrush="Transparent" BorderThickness="1">
                                            <Grid IsHitTestVisible="False">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Data="M 1,1 L 5,5 L 9,1" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" Width="10" Height="6" VerticalAlignment="Center" />
                                                <ContentPresenter Grid.Column="1" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Data" Value="M 1,5 L 5,1 L 9,5" /></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Host" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="LogContent" ContentSource="Content" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="LogContent" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="FolderCandidateTemplate">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="使用此目录" Style="{StaticResource SettingsTextButton}" Margin="0,0,14,0"
                            Command="{Binding DataContext.ApplyDefaultFolderCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button Content="取消" Style="{StaticResource SettingsTextButton}"
                            Command="{Binding DataContext.CancelDefaultFolderCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#F8F7F5" BorderBrush="#E7E4E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,26,12,0" KeyboardNavigation.TabNavigation="Continue">
                <TextBlock Text="设置" FontSize="19" FontWeight="SemiBold" Margin="10,0,0,28" />
                <RadioButton x:Name="FoldersSectionButton" Style="{StaticResource SettingsNav}" AutomationProperties.Name="文件夹"
                             IsChecked="{Binding IsFoldersSettings, Mode=TwoWay}" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="folders">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource SettingsNavIcon}" Data="M 2,5 L 8,5 L 10,7 L 20,7 L 20,19 L 2,19 Z" />
                        <TextBlock Text="文件夹" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="DiagnosticsSectionButton" Style="{StaticResource SettingsNav}" AutomationProperties.Name="诊断与反馈"
                             IsChecked="{Binding IsDiagnosticsSettings, Mode=TwoWay}" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="diagnostics">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource SettingsNavIcon}" Data="M 3,3 L 19,3 L 19,15 L 10,15 L 5,19 L 5,15 L 3,15 Z M 7,7 L 15,7 M 7,11 L 12,11" />
                        <TextBlock Text="诊断与反馈" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="AboutSectionButton" Style="{StaticResource SettingsNav}" AutomationProperties.Name="关于"
                             IsChecked="{Binding IsAboutSettings, Mode=TwoWay}" Command="{Binding SelectSettingsSectionCommand}" CommandParameter="about">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource SettingsNavIcon}" Data="M 11,2 A 9,9 0 1 1 10.99,2 M 11,6 L 11,7 M 11,10 L 11,16" />
                        <TextBlock Text="关于" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="SettingsContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <Grid Margin="36,50" MaxWidth="760">
                <StackPanel Visibility="{Binding IsFoldersSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="文件夹" Style="{StaticResource SettingsTitle}" />
                    <TextBlock Text="游戏文件夹" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <StackPanel>
                            <Grid Margin="0,20,0,17">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,3,18,0">
                                    <TextBlock Text="默认 Mods 文件夹" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="各检测共用的默认位置" Style="{StaticResource SettingsDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ModsRootDisplay}" ToolTip="{Binding ModsRoot}" Style="{StaticResource SettingsPath}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="OpenModsButton" Content="打开文件夹" Style="{StaticResource SettingsButton}" Margin="0,0,10,0" Command="{Binding OpenModsFolderCommand}" />
                                            <Button x:Name="ChangeDefaultModsButton" Content="更改" Style="{StaticResource SettingsButton}" Command="{Binding ChangeDefaultModsRootCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="文件夹不可访问" Style="{StaticResource SettingsFeedback}" HorizontalAlignment="Right" Visibility="{Binding HasModsRootAvailabilityWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button x:Name="FindModsButton" Content="重新查找默认目录" Style="{StaticResource SettingsTextButton}" HorizontalAlignment="Right" Margin="0,10,0,0" Command="{Binding FindDefaultFolderCommand}" CommandParameter="Mods" />
                                    <TextBlock Text="{Binding ModsFolderFeedback}" Style="{StaticResource SettingsFeedback}" />
                                    <ContentControl Content="{Binding FolderCandidate}" ContentTemplate="{StaticResource FolderCandidateTemplate}" Visibility="{Binding HasModsFolderCandidate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                            <Border Background="#ECE9E5" Height="1" />
                            <Grid Margin="0,20,0,17">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,3,18,0">
                                    <TextBlock Text="Tray 文件夹" Style="{StaticResource SettingsLabel}" />
                                    <TextBlock Text="用于图库检测，当前尚未开放" Style="{StaticResource SettingsDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TrayRootDisplay}" ToolTip="{Binding TrayRoot}" Style="{StaticResource SettingsPath}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="OpenTrayButton" Content="打开文件夹" Style="{StaticResource SettingsButton}" Margin="0,0,10,0" Command="{Binding OpenTrayFolderCommand}" Visibility="{Binding HasTrayRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button x:Name="ChangeTrayButton" Content="{Binding TrayRootActionText}" Style="{StaticResource SettingsButton}" Command="{Binding ChangeTrayRootCommand}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="文件夹不可访问" Style="{StaticResource SettingsFeedback}" HorizontalAlignment="Right" Visibility="{Binding HasTrayRootAvailabilityWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button x:Name="ClearTrayButton" Content="清除" Style="{StaticResource SettingsTextButton}" Margin="0,0,14,0" Command="{Binding ClearTrayRootCommand}" Visibility="{Binding HasTrayRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button x:Name="FindTrayButton" Content="重新查找默认目录" Style="{StaticResource SettingsTextButton}" Command="{Binding FindDefaultFolderCommand}" CommandParameter="Tray" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding TrayFolderFeedback}" Style="{StaticResource SettingsFeedback}" />
                                    <ContentControl Content="{Binding FolderCandidate}" ContentTemplate="{StaticResource FolderCandidateTemplate}" Visibility="{Binding HasTrayFolderCandidate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="更改默认位置不会修改已添加的扫描范围" Style="{StaticResource SettingsDescription}" Margin="2,14,0,0" />
                    <TextBlock Text="{Binding SettingsFeedback}" Style="{StaticResource SettingsFeedback}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsDiagnosticsSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="诊断与反馈" Style="{StaticResource SettingsTitle}" />
                    <TextBlock Text="错误记录" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="本工具的运行与启动错误" Style="{StaticResource SettingsDescription}" Margin="0,6,0,15" />
                    <TextBlock Text="暂时没有错误记录" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,16" Visibility="{Binding HasNoDiagnosticErrors, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding DiagnosticLogs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SettingsGroup}" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding ShowEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Expander Header="{Binding Name}" HorizontalContentAlignment="Stretch" Style="{StaticResource SettingsLogExpander}">
                                        <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="260"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0"
                                                 Background="Transparent" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Margin="0,10,0,0" />
                                    </Expander>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,14,0,0">
                        <Button x:Name="CopyDiagnosticsButton" Content="复制诊断信息" Style="{StaticResource SettingsButton}" Command="{Binding CopyDiagnosticsCommand}" Margin="0,0,10,10" />
                        <Button Content="打开日志文件夹" Style="{StaticResource SettingsButton}" Command="{Binding OpenLogFolderCommand}" Margin="0,0,10,10" />
                        <Button Content="刷新" Style="{StaticResource SettingsTextButton}" Command="{Binding RefreshDiagnosticsCommand}" Margin="0,0,0,10" />
                    </WrapPanel>
                    <TextBlock Text="{Binding DiagnosticsFeedback}" Style="{StaticResource SettingsFeedback}" />
                    <TextBlock Text="反馈问题" FontSize="15" FontWeight="SemiBold" Margin="0,32,0,0" />
                    <TextBlock Text="可附上诊断信息，帮助定位问题" Style="{StaticResource SettingsDescription}" />
                    <Button Content="前往 GitHub 反馈" Style="{StaticResource SettingsTextButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding OpenFeedbackCommand}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsAboutSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="关于" Style="{StaticResource SettingsTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource BrandMarkImage}" Width="38" Height="48" Margin="0,0,18,0" IsHitTestVisible="False" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sims 4 Mod Sieve" Style="{StaticResource BrandTextStyle}" FontSize="22" />
                            <TextBlock Text="{Binding ProductVersion, StringFormat=版本 {0}}" Style="{StaticResource SettingsDescription}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="本地离线的《模拟人生 4》Mod 整理工具" Style="{StaticResource SettingsDescription}" Margin="0,20,0,26" />
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="项目主页" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                        <Button Content="前往 GitHub" Style="{StaticResource SettingsTextButton}" HorizontalAlignment="Right" Command="{Binding OpenProjectCommand}" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="MIT 许可证" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                        <Button x:Name="LicenseButton" Content="查看许可证" Style="{StaticResource SettingsTextButton}" HorizontalAlignment="Right" Command="{Binding OpenLicenseCommand}" CommandParameter="LICENSE" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="第三方声明" Style="{StaticResource SettingsLabel}" VerticalAlignment="Center" />
                        <Button Content="查看声明" Style="{StaticResource SettingsTextButton}" HorizontalAlignment="Right" Command="{Binding OpenLicenseCommand}" CommandParameter="THIRD-PARTY-NOTICES.md" />
                    </Grid>
                    <TextBlock Text="{Binding AboutFeedback}" Style="{StaticResource SettingsFeedback}" />
                    <TextBox Text="{Binding LicenseText, Mode=OneWay}" Visibility="{Binding HasLicenseText, Converter={StaticResource BooleanToVisibilityConverter}}"
                             IsReadOnly="True" TextWrapping="Wrap" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0"
                             FontSize="12" BorderBrush="#F0EEEB" Padding="12" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
