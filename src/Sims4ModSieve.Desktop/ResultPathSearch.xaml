<UserControl x:Class="Sims4ModSieve.Desktop.ResultPathSearch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             VerticalAlignment="Center" IsTabStop="False">
    <UserControl.Resources>
        <sys:Double x:Key="SearchIconSize">16</sys:Double>
        <sys:Double x:Key="SearchClearTarget">24</sys:Double>
        <sys:Double x:Key="SearchInputFontSize">12</sys:Double>
        <Thickness x:Key="SearchInputMargin">0,1,4,1</Thickness>
        <Thickness x:Key="SearchClearMargin">0,1,3,1</Thickness>
        <DropShadowEffect x:Key="SearchShadow" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.13" />
        <TranslateTransform x:Key="SearchIconOffset" X="1" Y="1" />
    </UserControl.Resources>
    <Grid x:Name="SearchBox" Background="Transparent">
        <Border x:Name="SearchSurface" Background="{StaticResource SurfaceSunkenBrush}" Opacity="0"
                Effect="{StaticResource SearchShadow}" IsHitTestVisible="False" />
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="IconColumn" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="OpenSearch" Style="{StaticResource BareIconButtonStyle}" Background="Transparent"
                    AutomationProperties.Name="打开搜索" Click="OpenSearch_Click">
                <Path Data="M 10,6 A 4,4 0 1 1 2,6 A 4,4 0 1 1 10,6 M 9,9 L 13,13"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                      Width="{StaticResource SearchIconSize}" Height="{StaticResource SearchIconSize}" Stretch="Uniform"
                      RenderTransform="{StaticResource SearchIconOffset}" IsHitTestVisible="False" />
            </Button>
            <TextBox x:Name="QueryInput" Grid.Column="1" Visibility="Collapsed"
                     AutomationProperties.Name="按文件路径搜索" VerticalContentAlignment="Center"
                     BorderThickness="0" Padding="0" Margin="{StaticResource SearchInputMargin}" Background="Transparent"
                     Foreground="{StaticResource InkBrush}" FontSize="{StaticResource SearchInputFontSize}"
                     PreviewKeyDown="QueryInput_PreviewKeyDown" />
            <Button x:Name="ClearSearch" Grid.Column="2" Style="{StaticResource BareIconButtonStyle}"
                    Visibility="Collapsed" Background="Transparent" AutomationProperties.Name="清空搜索"
                    Width="{StaticResource SearchClearTarget}" Margin="{StaticResource SearchClearMargin}" Click="ClearSearch_Click">
                <Path Data="M 1,1 L 8,8 M 8,1 L 1,8" StrokeThickness="1.4" IsHitTestVisible="False"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
