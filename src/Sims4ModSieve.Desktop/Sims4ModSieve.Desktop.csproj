<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Sims4ModSieve.ico</ApplicationIcon>
    <AssemblyName>Sims4ModSieve</AssemblyName>
    <RootNamespace>Sims4ModSieve.Desktop</RootNamespace>
    <!-- 自定义入口先处理安装器检查，并负责启动画面的零时长关闭。 -->
    <StartupObject>Sims4ModSieve.Desktop.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <SplashScreen Include="Assets\splash.png" />
    <EmbeddedResource Include="Assets\supporters.json" LogicalName="Sims4ModSieve.Desktop.Assets.supporters.json" />
    <InternalsVisibleTo Include="Sims4ModSieve.Desktop.Tests" />
    <Resource Include="Assets\Fonts\SourceHanSansCN-Light.otf" />
    <Content Include="Assets\Fonts\source-han-sans-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\release\安装版使用说明.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\Sims4ModSieve.Core\Sims4ModSieve.Core.csproj" />
    <ProjectReference Include="..\Sims4ModSieve.Packages\Sims4ModSieve.Packages.csproj" />
  </ItemGroup>
</Project>
