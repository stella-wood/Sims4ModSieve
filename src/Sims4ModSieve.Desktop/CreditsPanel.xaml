<UserControl x:Class="Sims4ModSieve.Desktop.CreditsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Sims4ModSieve.Desktop"
             IsVisibleChanged="Panel_IsVisibleChanged" Unloaded="Panel_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/CreditsIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="CelebrationSurface" Background="Transparent" ClipToBounds="True"
          PreviewMouseDown="Surface_PreviewMouseDown">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="SupportersScroll" Margin="88,52,88,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource PageVerticalScrollBarStyle}" /></ScrollViewer.Resources>
            <StackPanel>
                <TextBlock Text="感谢名单" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,38" />
                <Border x:Name="SupporterFrame" Background="Transparent" BorderBrush="#E5E1E6" BorderThickness="0.5" Padding="28,30">
                    <StackPanel>
                        <ItemsControl x:Name="SupporterList" ItemsSource="{Binding SupporterNames}"
                                      Visibility="{Binding HasSupporters, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,22">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="14" Margin="0,0,28,16" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AfdianButton" Content="前往爱发电" HorizontalAlignment="Left" IsEnabled="False"
                                Style="{DynamicResource SettingsTextButton}" ToolTip="链接待补充" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,26,0,24">
            <Button x:Name="ConfettiButton" HorizontalAlignment="Center" Width="48" Height="48"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                    ToolTip="撒一点礼花" AutomationProperties.Name="撒一点礼花" Click="ConfettiButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="FloatingFace" Background="White" BorderBrush="#EAE3EF" BorderThickness="0.7" CornerRadius="24" Margin="2"
                                    IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                                <Border.Effect><DropShadowEffect Color="#473552" BlurRadius="12" ShadowDepth="2" Opacity="0.18" /></Border.Effect>
                                <Grid x:Name="PartyIcon" Width="24" Height="24" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                    <Path Fill="#E4D9EC" Stroke="#8F789E" StrokeThickness="1.2" StrokeLineJoin="Round"
                                          Data="M 3,21 L 7,8 L 16,17 Z" />
                                    <Path Stroke="#B392C4" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 10,5 C 10,2 14,5 14,1 M 16,10 C 19,10 17,6 21,6 M 17,15 L 21,13 M 6,13 L 12,19" />
                                    <Path Fill="#D4AA70" Data="M 17,2 L 19,3 L 18,5 L 16,4 Z M 21,9 L 23,10 L 22,12 L 20,11 Z" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FloatingFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.86" Duration="0:0:0.06" />
                                        <DoubleAnimation Storyboard.TargetName="FloatingFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.86" Duration="0:0:0.06" />
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FloatingFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" FillBehavior="Stop">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="0.86" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.12"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="1"><EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="6" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FloatingFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" FillBehavior="Stop">
                                            <DiscreteDoubleKeyFrame KeyTime="0" Value="0.86" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="1.12"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="1"><EasingDoubleKeyFrame.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="6" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FloatingFace" Property="Opacity" Value="0.5" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FloatingFace" Property="Background" Value="#FBF8FC" />
                                <Setter TargetName="PartyIcon" Property="RenderTransform"><Setter.Value><RotateTransform Angle="-8" /></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        <local:CreditsEffectsLayer x:Name="EffectsOverlay" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True" />
        <Border x:Name="SecretMessage" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0"
                Grid.RowSpan="2"
                VerticalAlignment="Center" Margin="88,0,88,0" Background="Transparent" Padding="20,18">
            <TextBlock Text="感谢每一位提过建议、反馈过问题的人，&#10;请我吃过薯片的朋友们，以及亲爱的 agent 们。&#10;&#10;谢谢你还在使用它"
                       TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{StaticResource AccentBrush}" />
        </Border>
    </Grid>
</UserControl>
