<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 单实例测试使用本程序集入口启动锁探针。 -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sims4ModSieve.Core\Sims4ModSieve.Core.csproj" />
    <ProjectReference Include="..\..\src\Sims4ModSieve.Cli\Sims4ModSieve.Cli.csproj" />
    <ProjectReference Include="..\..\src\Sims4ModSieve.Desktop\Sims4ModSieve.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Sims4ModSieve.Core.Tests\Packages\DbpfFixtureBuilder.cs" Link="Shared\DbpfFixtureBuilder.cs" />
    <Compile Include="..\Sims4ModSieve.Core.Tests\TempDirectory.cs" Link="Shared\TempDirectory.cs" />
    <Content Include="..\fixtures\duplicates\**\*" Link="Fixtures\Duplicates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Sims4ModSieve.Desktop\Assets\Sims4ModSieve.ico" Link="Assets\Sims4ModSieve.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Sims4ModSieve.FileOperations" />
  </ItemGroup>
</Project>
